{
  "manifest_version": 2,
  "name": "Add-ons Exporter",
  "version": "1.0",
  "description": "One click to export your installed add-ons as a printable HTML report with real store links.",
  "permissions": [
    "management",
    "downloads",
    "https://addons.mozilla.org/*"
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "addons-exporter@local"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "96": "icons/icon96.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "scripts": ["background.js"]
  },
  "browser_action": {
    "default_title": "Export my add-ons",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png"
    }
  }
}
