{
  "manifest_version": 3,
  "name": "Add-ons Exporter",
  "version": "1.2.0",
  "description": "Export or import your installed add-ons as an HTML report with real store links.",
  "permissions": [
    "management",
    "downloads"
  ],
  "host_permissions": [
    "https://addons.mozilla.org/*"
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "addons-exporter@local",
      "strict_min_version": "109.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "96": "icons/icon96.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "scripts": ["common.js", "background.js"]
  },
  "action": {
    "default_title": "Add-ons Exporter",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png"
    }
  }
}
