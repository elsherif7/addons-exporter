{
  "manifest_version": 3,
  "name": "Add-ons Hub",
  "version": "1.2.0",
  "description": "A Firefox WebExtension for managing your installed add-ons, starting with Add-ons Exporter and Add-ons Importer.",
  "permissions": [
    "management",
    "downloads"
  ],
  "host_permissions": [
    "https://addons.mozilla.org/*"
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "addons-exporter@local",
      "strict_min_version": "109.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    },
    "gecko_android": {
      "strict_min_version": "113.0"
    }
  },
  "icons": {
    "16": "src/icons/icon16.png",
    "32": "src/icons/icon32.png",
    "48": "src/icons/icon48.png",
    "96": "src/icons/icon96.png",
    "128": "src/icons/icon128.png"
  },
  "background": {
    "scripts": ["src/common/common.js", "src/background/report-template.js", "src/background/background.js"]
  },
  "action": {
    "default_title": "Add-ons Hub",
    "default_popup": "src/popup/popup.html",
    "default_icon": {
      "16": "src/icons/icon16.png",
      "32": "src/icons/icon32.png",
      "48": "src/icons/icon48.png"
    }
  }
}
