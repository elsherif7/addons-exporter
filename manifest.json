{
  "manifest_version": 2,
  "name": "ExtMover",
  "version": "1.0",
  "description": "One click to export your installed extensions as a printable HTML report with real store links.",
  "permissions": [
    "management",
    "downloads",
    "https://addons.mozilla.org/*"
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "extmover@local"
    }
  },
  "background": {
    "scripts": ["background.js"]
  },
  "browser_action": {
    "default_title": "Export my extensions"
  }
}
