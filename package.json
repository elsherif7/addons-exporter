{
  "name": "addons-hub",
  "version": "1.2.0",
  "description": "A Firefox WebExtension for managing your installed add-ons.",
  "private": true,
  "scripts": {
    "build": "node scripts/build-assets.js",
    "check": "node scripts/build-assets.js --check && node scripts/check-syntax.js",
    "pretest": "npm run check",
    "test": "node --test --test-reporter=spec",
    "pretest:coverage": "npm run check",
    "test:coverage": "c8 node --require ./tests/coverage-preload.js --test",
    "lint:ext": "npx --yes web-ext@10.8.0 lint",
    "clean": "node scripts/clean.js",
    "set-version": "node scripts/set-version.js"
  },
  "devDependencies": {
    "c8": "^10.1.3"
  },
  "engines": {
    "node": ">=22"
  },
  "license": "GPL-3.0-only"
}
